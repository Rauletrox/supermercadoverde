{
  "name": "exp1_s2_raulzuniga",
  "version": "1.0.0",
  "description": "Inventario académico con React, estado global y Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:ui": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests *.js *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests *.js *.json .github/workflows/*.yml",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module"
}
